{
    "compilerOptions": {
      "target": "ESNext",
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "module": "ESNext",
      "moduleResolution": "bundler",
      "jsx": "react-jsx",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "noEmit": true,
      "isolatedModules": true,
      "resolveJsonModule": true,
      "paths": {
        "@/*": ["./resources/js/*"]
      }
    },
    "include": ["resources/js/**/*"]
  }
